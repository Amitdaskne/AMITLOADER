<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C96612" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFB85A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFF6A13A" android:endColor="#FF18B7A4" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FF7CF8FF" />
        </shape>
    </item>
</selector>
