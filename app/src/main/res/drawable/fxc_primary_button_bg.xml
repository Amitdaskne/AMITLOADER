<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FFF9FBFD" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF245477" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF6A3DCC" android:endColor="#FF4D2A9E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF60CFC2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF18B7A4" android:centerColor="#FF7651E8" android:endColor="#FF18B7A4" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF60CFC2" />
        </shape>
    </item>
</selector>
